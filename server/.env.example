

# Override for which app's trades count toward the growth challenge.
#
# Normally leave this EMPTY: it falls back to MARKUP_APP_ID, which is the same
# value as the frontend's CLIENT_ID — the app that issues the OAuth2 token
# trades are placed under. Set it only if those two ever diverge.
#
# Whatever it resolves to must equal the `app_id` Deriv puts on a profit_table
# row, or nothing matches and the challenge sits at zero.
DERIV_TRADING_APP_ID=

# Shared secret for the hand-driven admin routes: GET /api/admin/list and
# POST/DELETE /api/admin, which write the admin allow-list. Send it as the
# X-Admin-Token header (a bearer token also works).
#
# Required: with this unset those three routes answer 503 rather than falling
# open. Nothing a customer touches depends on them, and the admin UI does not
# call them, so leaving it unset breaks no screen.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=

# ── Crypto rails ────────────────────────────────────────────────────────────
# Each chain pays to its own address. There is no shared default and no
# fallback between them: USDC sent to a TRON address, or USDT to an Ethereum
# one, is gone. A chain with no address here is simply not offered at the
# checkout, which is why an unconfigured rail is safe rather than broken.

# USDT on TRON. Already in use.
# TRON_WALLET_ADDRESS=

# USDC on Ethereum. Set this to switch the ERC-20 option on.
ETH_WALLET_ADDRESS=

# Etherscan key for watching that address. Without one the free tier rate
# limits hard and paid orders will be slow to settle, or miss.
ETHERSCAN_API_KEY=

# Optional overrides: the API base, the chain id, and the USDC contract.
# ETHERSCAN_API_URL=https://api.etherscan.io/v2/api
# ETH_CHAIN_ID=1
# USDC_CONTRACT=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
