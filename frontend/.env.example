CLIENT_ID=
APP_ID=
# Set TUNNEL=1 when dev-serving through an https tunnel (ngrok/cloudflare) so HMR uses port 443.
TUNNEL=

# Backend API base URL. Leave EMPTY in dev — requests go same-origin (/api) and the
# Vite dev server proxies them to localhost:4000 (see vite.config.ts).
# In PRODUCTION set this to the backend's public URL (baked in at build time):
#   API_URL=https://api.yourdomain.com
API_URL=
